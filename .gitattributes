# 换行统一：仓库内存 LF，检出按各平台习惯。
# 目的是让 Linux / macOS / WSL 上 clone 下来的 .py 能直接跑。
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析会出问题
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制，不做任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.docx binary
*.pptx binary
